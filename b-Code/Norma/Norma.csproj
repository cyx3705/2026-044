<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="NormaVersion.props" />

  <PropertyGroup>
    <!--
      net8.0-windows 与宿主一致；纯逻辑模块也可以用 net8.0。
      模块本身不画界面：页面走 Aurora 描述协议（见 NormaPage.cs），不要引用 WPF。
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Norma</AssemblyName>
    <RootNamespace>Norma</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
    <!-- 假定本仓与 2026-023-HistoryVulcan 在同一库根下；F 盘工作区由 Directory.Build.user.props 覆盖。 -->
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 标准代号表随 DLL 走，部署时不需要额外数据文件。 -->
    <EmbeddedResource Include="Formulas\physical-*.tsv" />
    <EmbeddedResource Include="ManualWindowCapture.ps1" LogicalName="Norma.ManualWindowCapture.ps1" />
    <EmbeddedResource Include="Formulas\standards.tsv" LogicalName="Norma.Formulas.standards.tsv" />
    <!-- 硬度—强度换算节点表（机械工程师手册 sjzl 章），PCHIP 的锚点。 -->
    <EmbeddedResource Include="Formulas\metal-high.tsv" LogicalName="Norma.Formulas.metal-high.tsv" />
    <EmbeddedResource Include="Formulas\metal-low.tsv" LogicalName="Norma.Formulas.metal-low.tsv" />
    <EmbeddedResource Include="Formulas\metal-shore.tsv" LogicalName="Norma.Formulas.metal-shore.tsv" />
    <EmbeddedResource Include="Formulas\metal-aluminum.tsv" LogicalName="Norma.Formulas.metal-aluminum.tsv" />
    <EmbeddedResource Include="Formulas\metal-copper-low.tsv" LogicalName="Norma.Formulas.metal-copper-low.tsv" />
    <EmbeddedResource Include="Formulas\metal-copper-high.tsv" LogicalName="Norma.Formulas.metal-copper-high.tsv" />
  </ItemGroup>
</Project>
